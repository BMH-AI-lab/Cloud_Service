   "source": [
    "# 피보나치 수 \n",
    "def solution(n):\n",
    "    if n == 0:\n",
    "        return 0\n",
    "    elif n == 1:\n",
    "        return 1\n",
    "    \n",
    "    a, b = 0, 1\n",
    "    for i in range(2, n + 1):\n",
    "        a, b = b, a + b\n",
    "    return b % 1234567\n",
    "    \n",
    "solution(10) "
   ]
