                "// 객체 \r\n\r\nlet personName = \"홍길;동\"\r\nlet personAge = 25;\r\nlet personCity = \"서울\";\r\n\r\nlet person = {\r\n    name: \"홍길동\", \r\n    age: 25, \r\n    city: \"서울\", \r\n}\r\n\r\nconsole.log(person.name);\r\nconsole.log(person.age);\r\nconsole.log(person.city);\r\nconsole.log();\r\n\r\nconsole.log(person[\"age\"]);\r\nconsole.log(person[\"city\"]);\r\nconsole.log();\r\n\r\nlet key = \"city\";\r\nconsole.log(person[key]);\r\n\r\nperson.job = \"개발자\"\r\nconsole.log(person);\r\nconsole.log();\r\n\r\nperson.age = 30;\r\nconsole.log(person.age);\r\nconsole.log();\r\n\r\ndelete person.city;\r\nconsole.log(person.city);\r\nconsole.log();\r\n\r\n\r\n"
            ],
