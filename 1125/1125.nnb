        {
            "language": "typescript",
            "source": [
                "// 재귀함수 \r\n// 함수가 자기 자신을 호출\r\n\r\nconst factorial = (n) => {\r\n    // 재귀함수 종료조건\r\n    if (n == 1) return 1;\r\n    return n * factorial(n -1);\r\n};\r\n\r\nfactorial(5);"
            ],
            "outputs": [
                {
                    "items": [
                        {
                            "mime": "application/vnd.code.notebook.stdout",
                            "value": [
                                "",
                                ""
                            ]
                        }
                    ]
                },
                {
                    "items": [
                        {
                            "mime": "text/plain",
                            "value": [
                                "\u001b[33m120\u001b[39m"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "language": "typescript",
            "source": [
                "// 스코프(Scope)\r\n// 변수의 유효 범위\r\n\r\n// 파이썬의 들여쓰기 같은 거\r\n\r\n\r\nlet globalVar = \"전역변수\";\r\nfunction function1(){\r\n    let localVar = \"지역변수\";\r\n    console.log(globalVar)\r\n    console.log(localVar)\r\n\r\n}\r\n\r\n\r\nfunction1()\r\nconsole.log(globalVar);\r\nconsole.log(localVar)\r\n"
            ],
            "outputs": [
                {
                    "items": [
                        {
                            "mime": "application/vnd.code.notebook.stdout",
                            "value": [
                                "전역변수",
                                "지역변수",
                                "",
                                ""
                            ]
                        }
                    ]
                },
