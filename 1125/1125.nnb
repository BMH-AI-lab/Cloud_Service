            "source": [
                "let arrays = [3, 7, 2, 9, 5, 1, 8]\r\n\r\n// 1. 5보다 큰 숫자만 필터링 \r\nlet evens = arrays.filter((arrays) => arrays > 5);\r\nconsole.log(evens);\r\n\r\n// 2. 각 숫자를 제곱 \r\nlet result = arrays.map((arrays) => arrays ** 2);\r\nconsole.log(result);\r\n\r\n// 3. 오름차순 정렬\r\nlet sort1 = arrays.sort();\r\nconsole.log(sort1);"
            ],
