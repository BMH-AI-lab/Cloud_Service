        {
            "language": "typescript",
            "source": [
                "// 재귀함수 \r\n// 함수가 자기 자신을 호출\r\n\r\nconst factorial = (n) => {\r\n    // 재귀함수 종료조건\r\n    if (n == 1) return 1;\r\n    return n * factorial(n -1);\r\n};\r\n\r\nfactorial(5);"
            ],
            "outputs": [
                {
                    "items": [
                        {
                            "mime": "application/vnd.code.notebook.stdout",
                            "value": [
                                "",
                                ""
                            ]
