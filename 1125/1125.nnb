        {
            "language": "typescript",
            "source": [
                "//콜백함수 \r\n// 다른 함수의 인자로 전달되는 함수 \r\n\r\nfunction greet(name, callback){\r\n    console.log(`안녕하세요 ${name}님!`);\r\n    callback();\r\n}\r\n\r\nfunction sayGoodbye(){\r\n    console.log(\"안녕히 가세요!\")\r\n}\r\n\r\ngreet(\"홍길동\", sayGoodbye);"
            ],
            "outputs": [
                {
                    "items": [
                        {
                            "mime": "application/vnd.code.notebook.stdout",
                            "value": [
                                "안녕하세요 홍길동님!",
                                "안녕히 가세요!",
                                "",
                                ""
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "language": "typescript",
            "source": [
                "// 배열 메서드와 콜백 \r\n// 파이썬 리스트와 비슷함 \r\n\r\nlet numbers = [1, 2, 3, 4, 5]\r\nconsole.log(numbers[1]);\r\n\r\n//순회\r\nnumbers.forEach((num) => {\r\n    console.log(num * 2);\r\n});\r\n\r\n//filter\r\n\r\nlet evens = numbers.filter((num) => num % 2 ===0);\r\nconsole.log(evens);\r\n\r\n\r\n//map\r\n\r\nlet doubled = numbers.map((num) => num * 2);\r\nconsole.log(doubled);\r\nconsole.log();\r\nconsole.log();\r\nconsole.log();\r\nconsole.log();\r\nconsole.log();\r\nconsole.log();\r\nconsole.log();"
            ],
            "outputs": [
                {
                    "items": [
                        {
                            "mime": "application/vnd.code.notebook.stdout",
                            "value": [
                                "2",
                                "2",
                                "4",
                                "6",
                                "8",
                                "10",
                                "",
                                ""
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "language": "typescript",
            "source": [
                "let fruits = [\"사과\", \"바나나\", \"딸기\"];\r\nconsole.log(fruits.indexOf(\"바나나\"));\r\nconsole.log(fruits.includes(\"딸기\"))\r\nconsole.log(fruits.includes(\"수박\"))\r\n\r\n\r\nlet some = fruits.slice(1, 3);\r\nconsole.log(some);\r\nconsole.log(fruits);\r\n\r\n"
            ],
            "outputs": [
                {
                    "items": [
                        {
                            "mime": "application/vnd.code.notebook.stdout",
