            "language": "typescript",
            "source": [
                "let fruits = [\"복숭아\", \"수박\", \"포도\", \"딸기\", \"오렌지\"]\r\n\r\n// for문 모든 요소 출력 \r\nfor (let i = 0; i < fruits.length; i++) {\r\n  console.log(fruits[i]);\r\n};\r\n\r\nconsole.log();\r\n\r\n// for.....of 모든 요소 출력 \r\nfor (const fruit of fruits) {\r\n  console.log(fruit);\r\n}\r\n\r\nconsole.log();\r\n\r\n// forEach 모든 요소 출력 \r\nfruits.forEach(fruits=> {\r\n  console.log(fruits);\r\n});"
            ],
