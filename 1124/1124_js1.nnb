                "var oldVar = \"ES5 이전\";\r\n\r\nconst userName = \"홍길동\";\r\nconst userAge = 25;\r\nconst isStudent = true;\r\n\r\n// const lname = \"홍길동\";\r\n// const user-name = \"홍길동\";\r\n// const let = \"홍길동\";\r\n\r\nlet age = 20;\r\nconsole.log(age); // 20\r\n\r\n// camelCase 권장\r\nconst age1 = 25;\r\nconst userName1 = \"김철수\";\r\nconst price = 19.99;\r\nconst negativeNumber = -10;\r\n\r\nconsole.log(typeof age1); // \"number\"\r\n\r\nconst name1 = \"홍길동\";\r\nconst name2 = '김철수';\r\nconst name3 = `이영희`;\r\n\r\nconsole.log(typeof name3); // \"string\"\r\n\r\nconst listStudents1 = true;\r\nconst isTeacher = false;\r\n\r\nconsole.log(typeof isStudent); // \"boolean\"\r\n\r\nlet empty = null;\r\nlet notDefined;\r\n\r\nconsole.log(empty);       // null\r\nconsole.log(notDefined);  // undefined\r\n\r\n\r\n// 템플릿 문자열\r\nconsole.log(\"제 이름은 \" + name1 + \"이고, 나이는 \" + age1 + \"살입니다.\");\r\nconsole.log(`제 이름은 ${userName1}이고, 나이는 ${age}살입니다.`);\r\n"
