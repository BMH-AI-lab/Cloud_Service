                "const a = 10;\r\nconst b = 3;\r\n\r\nconsole.log(a + b); // 13\r\nconsole.log(a - b); // 7\r\nconsole.log(a * b); // 30\r\nconsole.log(a / b); // 3.3333...\r\nconsole.log(a % b); // 1\r\nconsole.log(a ** b); // 1000\r\n\r\nlet count = 0;\r\ncount++;\r\nconsole.log(\"count\", count); // 1\r\ncount--;\r\nconsole.log(\"count\", count); // 0\r\n\r\nlet x = 10;\r\nx += 5;  // x = x + 5\r\nconsole.log(\"x\", x);\r\n\r\nx-= 3;  // x = x - 3\r\nconsole.log(\"x\", x);\r\nx *= 2;  // x = x * 2\r\nconsole.log(\"x\", x);\r\n\r\nlet firstName = \"홍\";\r\nlet lastName = \"길동\";\r\n\r\nlet fullName = firstName + lastName;\r\nconsole.log(\"fullName\", fullName); // \"홍길동\"\r\n\r\n\r\n"
